@host = http://localhost:5117
@json = application/json

### Register a normal user
POST {{host}}/api/Auth/register
Content-Type: {{json}}

{
	"userName": "user1",
	"email": "user1@example.com",
	"password": "User#12345",
	"fullName": "User One"
}

### Login as admin (seeded at startup)
POST {{host}}/api/Auth/login
Content-Type: {{json}}

{
	"userNameOrEmail": "admin@smartmeetings.local",
	"password": "Admin#12345"
}

### Create a room (requires Admin role)
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..5PLYW5MeUy9XmFBU0xfez02nXhYrbyS4GNsnfVdKFtw
POST {{host}}/api/Rooms
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
	"name": "Board Room",
	"capacity": 10,
	"location": "Floor 3",
	"description": "Main board meeting room",
	"availability": true
}

### Get all rooms (any authenticated user)
GET {{host}}/api/Rooms
Authorization: Bearer {{token}}
Accept: {{json}}

### Get a room by id
GET {{host}}/api/Rooms/1
Authorization: Bearer {{token}}
Accept: {{json}}

